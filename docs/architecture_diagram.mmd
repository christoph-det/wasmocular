flowchart TB
  %% -------- External Sources --------
  subgraph External["External Sources"]
    direction LR
    RGR[Remote Git Repository]
    GH[GitHub REST API]
    LFS[Local Repository Folder]
  end

  P[Proxy<br/>CORS bypass]

  %% -------- Browser --------
  subgraph Browser["Browser"]
    direction LR

    %% React SPA (top-level UI)
    subgraph ReactSPA["React SPA"]
    direction LR
      UIApp[App + Site Router]
      UIPages[Pages]
      UIStores[MobX State Stores]
      UIApp --> UIPages
      UIPages --> UIStores
    end

    subgraph GitWorkers["Git Workers"]
      direction LR
      WG[WasmGit Worker<br/>Remote clone]
      WGIX[WasmGix Worker<br/>Local mount + indexing]
    end

    subgraph DataWorkers["Data Workers"]
      direction LR
      GHW[GitHub API Worker]
      DBW[DuckDB Worker]
    end

    subgraph Storage["Persistent Storage"]
      direction LR
      IDBFS[(IndexedDB<br/>/repos)]
      OPFS[(OPFS<br/>DuckDB)]
      LocalStorage[(LocalStorage)]
    end
  end

  %% -------- Data flows --------
  RGR --> P --> WG
  LFS -- "File System Access API" --> WGIX
  GH --> GHW

  %% -------- Storage flows --------
  WG --> IDBFS
  WGIX <--> IDBFS
  UIStores <-- "Project data" --> LocalStorage

  %% -------- Processing pipeline --------
  WGIX -- "Arrow IPC" --> DBW
  GHW -- "PR/Issue data" --> DBW
  DBW <--> OPFS

  %% -------- UI coordination --------
  UIStores -.- GitWorkers
  UIStores -.- DataWorkers
