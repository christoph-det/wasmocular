{
  "name": "wasmocular",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://christoph-det.github.io/masterarbeit",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:wasm-gix": "cargo build --release --target wasm32-unknown-emscripten --bin wasm_gix --no-default-features --manifest-path crates/wasm-gix/Cargo.toml && cp crates/wasm-gix/target/wasm32-unknown-emscripten/release/wasm_gix.js crates/wasm-gix/target/wasm32-unknown-emscripten/release/wasm_gix.wasm src/workers/wasm-gix-library/",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prettify": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@duckdb/duckdb-wasm": "^1.31.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "comlink": "^4.4.2",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@types/d3": "^7.4.3",
    "@types/emscripten": "^1.41.5",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.28",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^17.1.0",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "@tailwindcss/vite": "^4.0.14",
    "react-scan": "^0.4.3"
  }
}
