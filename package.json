{
  "name": "repminer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://christoph-det.github.io/masterarbeit",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:wasm": "cd wasm-lib && wasm-pack build --target web --out-dir pkg",
